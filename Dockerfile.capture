# syntax=docker/dockerfile:1.7

FROM golang:1.25-alpine AS build
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN go build -ldflags "-s -w" -o /out/calm-capture ./cmd/calm-capture

# exec wraps arbitrary shell commands, so the runtime image must carry a shell —
# distroless cannot. This image runs the agent-facing commands as-is; for exec
# to do real work the container must also carry the wrapped commands' tools:
# extend this image, or COPY --from it into the image where the agent runs.
FROM alpine:3.21
RUN adduser -D -u 65532 nonroot
COPY --from=build /out/calm-capture /usr/local/bin/calm-capture
USER nonroot
ENTRYPOINT ["/usr/local/bin/calm-capture"]
